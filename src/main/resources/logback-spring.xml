<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="msa-service"/>

    <!-- ================================================================
         CONSOLA
    ================================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================================================================
         ARCHIVO GENERAL — logs/application.log (rota diario, guarda 30 dias)
    ================================================================ -->
    <appender name="FILE_APP" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================================================================
         ARCHIVO DE AUDITORIA — logs/audit-access.log
         Solo captura el logger "AUDIT" (AuditLogFilter)
         Rota diario, guarda 90 dias para trazabilidad
    ================================================================ -->
    <appender name="FILE_AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/audit-access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/audit-access.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- Formato plano optimizado para parseo (grep, SIEM, etc.) -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================================================================
         LOGGERS ESPECIFICOS
    ================================================================ -->

    <!-- Logger de auditoria: escribe SOLO en FILE_AUDIT (y consola en dev) -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="FILE_AUDIT"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Reducir ruido de frameworks -->
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.web"       level="WARN"/>
    <logger name="com.nimbusds"                  level="WARN"/>

    <!-- ================================================================
         ROOT
    ================================================================ -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_APP"/>
    </root>

</configuration>
